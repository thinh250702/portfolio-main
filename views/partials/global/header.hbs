<header class="{{#if isLight}}is-light{{/if}} fixed top-0 left-0 w-full z-10" data-header data-event="{{#if isAbout}}polaroid:revealComplete{{/if}}">
  <div class="container mx-auto">
    <div class="bs-row py-4">
      <div class="flex items-center border-none outline-none rounded-full transition-all duration-300 ease-in-out" data-header-wrapper>
        <div class="flex-1">
          <a href="/">
            <div class="horizontal-logo h-10 light:bg-white transition-colors duration-200"></div>
          </a>
        </div>
        <nav class="hidden xl:flex gap-10 light:text-white transition-colors duration-200">
          {{#each settings.navigation}}
            <a href="{{url}}" class="nav-link">
              <span class="hover-text">
                <span data-label="({{title}})" class="label-lg uppercase">({{title}})</span>
              </span>
            </a>
          {{/each}}
        </nav>
        <div class="flex-1 flex justify-end gap-2">
          {{> components/language-dropdown header=true}}
          <a href="{{settings.resume.url}}" class="btn btn-dark light:bg-white light:text-black transition-colors duration-200 hidden xl:inline-flex">
            <span class="hover-text">
              <span data-label="{{settings.resume.label}}">{{settings.resume.label}}</span>
            </span>
            <i class="icon-arrow-up-right text-xs"></i>
          </a>
          <button type="button" class="menu-toggle btn btn-dark btn-icon light:bg-white light:text-black transition-colors duration-200 xl:hidden" data-menu-toggle>
            <i class="icon-menu text-[24px]"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>  
<div class="fixed top-0 left-0 h-screen w-screen z-15 bg-white flex flex-col p-4 invisible opacity-0 pointer-events-none" data-header-menu>
  <div class="flex justify-between" data-menu-item>
    {{> components/language-dropdown}}
    <button type="button" class="menu-toggle btn bg-gray-200 text-gray-400 btn-icon" data-menu-toggle>
      <i class="icon-close text-base"></i>
    </button>
  </div>
  <nav class="flex-1 flex flex-col justify-center -z-1">
    <a href="/" class="nav-link my-2" data-menu-item>
      <span class="hover-text">
        <span data-label="Home" class="text-7xl xl:text-8xl leading-none font-bold tracking-tight">Home</span>
      </span>
    </a>
    <a href="/about" class="nav-link my-2" data-menu-item>
      <span class="hover-text">
        <span data-label="About" class="text-7xl xl:text-8xl leading-none font-bold tracking-tight">About</span>
      </span>
    </a>
    <a href="/work" class="nav-link my-2" data-menu-item>
      <span class="hover-text">
        <span data-label="Work" class="text-7xl xl:text-8xl leading-none font-bold tracking-tight">Work</span>
      </span>
    </a>
    <a href="/contact" class="nav-link my-2" data-menu-item>
      <span class="hover-text">
        <span data-label="Contact" class="text-7xl xl:text-8xl leading-none font-bold tracking-tight">Contact</span>
      </span>
    </a>
  </nav>
  <div data-menu-item>
    <span class="uppercase title-md font-medium">Follow Me</span>
    <ul class="flex gap-2.5 mt-2">
      <li>
        <a href="https://www.facebook.com/thinh.nguyentruong.1884" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center rounded-full size-10 bg-gray-100">
          <i class="icon-facebook text-lg"></i>
        </a>
      </li>
      <li>
        <a href="https://www.instagram.com/rion.ng_" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center rounded-full size-10 bg-gray-100">
          <i class="icon-instagram text-lg"></i>
        </a>
      </li>
      <li>
        <a href="https://www.behance.net/thinhnguyen93" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center rounded-full size-10 bg-gray-100">
          <i class="icon-behance text-lg"></i>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/thinhnt02/" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center rounded-full size-10 bg-gray-100">
          <i class="icon-linkedIn text-lg"></i>
        </a>
      </li>
    </ul>
  </div>
</div>