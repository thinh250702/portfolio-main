<header class="{{#if isLight}}is-light{{/if}} fixed top-0 left-0 w-full z-10" data-header data-event="{{#if isAbout}}polaroid:revealComplete{{/if}}">
  <div class="container mx-auto">
    <div class="bs-row py-4">
      <div class="flex items-center border-none outline-none rounded-full transition-all duration-300 ease-in-out" data-header-wrapper>
        <div class="flex-1">
          <a href="/">
            <div class="horizontal-logo h-10 light:bg-white transition-colors duration-200"></div>
          </a>
        </div>
        <nav class="hidden xl:flex gap-12 light:text-white transition-colors duration-200">
          {{#each settings.navigation}}
            <a href="{{url}}" class="label-lg uppercase" data-text-roll>({{title}})</a>
          {{/each}}
        </nav>
        <div class="flex-1 flex justify-end gap-2">
          {{> components/language-dropdown header=true}}
          <a href="{{settings.resume.url}}" target="_blank" rel="noopener noreferrer" class="btn btn-dark light:bg-white light:text-black transition-colors duration-200 hidden xl:inline-flex">
            <span data-text-roll>{{settings.resume.label}}</span>
            <i class="icon-arrow-up-right text-xs"></i>
          </a>
          <button type="button" class="menu-toggle btn btn-dark btn-icon light:bg-white light:text-black transition-colors duration-200 xl:hidden" data-menu-toggle>
            <i class="icon-menu text-[24px]"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>  
<div class="fixed top-0 left-0 h-screen w-screen z-15 bg-white flex flex-col  invisible pointer-events-none" data-header-menu>
  <div class="container mx-auto h-full">
    <div class="bs-row h-full">
      <div class="bs-col-12 flex flex-col py-4">
        <div class="flex justify-between z-1" data-menu-item>
          {{> components/language-dropdown}}
          <button type="button" class="menu-toggle btn bg-gray-200 text-gray-400 btn-icon" data-menu-toggle>
            <i class="icon-close text-base"></i>
          </button>
        </div>
        <nav class="flex-1 flex flex-col justify-center">
          {{#each settings.navigation}}
          <a href="{{url}}" class="text-7xl lg:text-8xl font-medium leading-none tracking-tighter my-2" data-menu-item data-text-roll>{{title}}</a>
          {{/each}}
        </nav>
        <div data-menu-item>
          <span class="uppercase title-md font-medium">Follow Me</span>
          <ul class="flex gap-2.5 mt-2">
            {{#each settings.socials}}
            <li>
              <a href="{{url}}" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center rounded-full size-10 bg-gray-100">
                <i class="{{icon}} text-lg"></i>
              </a>
            </li>
            {{/each}}
          </ul>
        </div>
      </div>
    </div> 
  </div>
</div>