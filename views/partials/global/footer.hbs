<footer class="bg-linear-to-b from-black to-gray-700 relative -mt-px">
  <div class="w-full h-1/2 absolute bottom-0 bg-[url(https://res.cloudinary.com/dbmobxcxq/image/upload/v1784730393/portfolio-2026/nww28lqrmvrqwmlcnfyu_mb37px.webp)] bg-cover bg-repeat-x bg-bottom"></div>
  <div class="container mx-auto">
    <div class="bs-row py-20 justify-between">
      <div class="bs-col-12 lg:bs-col-6">
        <h2 class="h1 tracking-tighter font-medium text-white mb-6" data-text-reveal>{{settings.footer.title}}</h2>
        <span class="inline-block title-sm sm:h5 font-medium px-5 py-2.5 text-white border border-white rounded-full" data-reveal="">{{settings.email}}</span>
      </div>
      <div class="bs-col-12 lg:bs-col-5 flex" data-reveal="group">
        <div class="flex-1 pt-10 lg:pt-0">
          <p class="label-xs font-medium uppercase mb-4 text-gray-500">(Navigation)</p>
          <div>
            <ul>
              {{#each settings.navigation}}
              <li class="mb-2">
                <a class="hover-link hover-link-light" href="{{url}}">{{title}}</a>
              </li>
              {{/each}}
            </ul>
          </div>
        </div>
        <div class="flex-1 pt-10 lg:pt-0">
          <p class="label-xs font-medium uppercase mb-4 text-gray-500">(Social Media)</p>
          <div>
            <ul>
              {{#each settings.socials}}
              <li class="mb-2">
                <a class="hover-link hover-link-light" href="{{url}}" target="_blank" rel="noopener noreferrer">{{name}}</a>
              </li>
              {{/each}}
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="bs-row mx-4 sm:mx-0 px-0 justify-between pt-6 border-t border-white/10" data-reveal="group">
      <div class="bs-col-12 sm:bs-col-auto flex justify-center">
        <span class="text-white">{{settings.footer.license}}</span>
      </div>
      <div class="bs-col-12 sm:bs-col-auto flex justify-center mt-4 sm:mt-0">
        <button class="inline-flex items-center gap-2 text-white cursor-pointer" data-scroll-top>
          <i class="icon-round-arrow-up text-xl"></i>
          <span data-text-roll>{{settings.footer.backToTop}}</span>
        </button>
      </div>
    </div>
    <div class="bs-row py-20">
      <div class="bs-col">
        <div class="horizontal-logo bg-white w-full hidden sm:block"></div>
        <div class="vertical-logo bg-white w-full sm:hidden"></div>
      </div>
    </div>
  </div>
</footer>