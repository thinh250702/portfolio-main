<section id="contact" class="{{#if isHomepage}}py-20{{else}}pb-20 pt-5{{/if}}">
  <div class="container mx-auto">
    <!-- {{#unless isHomepage}}load{{/unless}}-->
    <div class="bs-row">
      <div class="bs-col-12 lg:bs-col-6 lg:pr-12">
        {{#if isHomepage}} 
          <span class="eyebrow" data-reveal>Portfolio</span>
          <h2 class="font-medium tracking-tighter mb-4" data-text-reveal>Get in touch with me</h2>
          <p class="text-gray-500 body-lg mb-8" data-text-reveal data-split="lines">We'd love to hear from you! Whether you have a project in mind, need a quote, or just want to say hello, feel free to reach out. Fill out the form below or use our contact details to connect with us.</p>
        {{/if}}
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-y-5 mb-8" data-reveal="group" data-trigger="{{#unless isHomepage}}load{{/unless}}" data-delay="{{#unless isHomepage}}0.4{{/unless}}">
          <li class="social-link">
            <a href="">
              <i class="icon-facebook"></i>
            </a>
            <div>
              <a class="hover-link font-medium" href="#">Facebook</a>
              <p class="social-link-handle">@username</p>
            </div>
          </li>
          <li class="social-link">
            <a href="">
              <i class="icon-instagram"></i>
            </a>
            <div>
              <a class="hover-link font-medium" href="#">Facebook</a>
              <p class="social-link-handle">@username</p>
            </div>
          </li>
          <li class="social-link">
            <a href="">
              <i class="icon-behance"></i>
            </a>
            <div>
              <a class="hover-link font-medium" href="#">Facebook</a>
              <p class="social-link-handle">@username</p>
            </div>
          </li>
          <li class="social-link">
            <a href="">
              <i class="icon-linkedIn"></i>
            </a>
            <div>
              <a class="hover-link font-medium" href="#">Facebook</a>
              <p class="social-link-handle">@username</p>
            </div>
          </li>
        </ul>
        <div>
          <p class="label-lg text-gray-400" data-text-reveal data-trigger="{{#unless isHomepage}}load{{/unless}}" data-delay="{{#unless isHomepage}}0.8{{/unless}}">Email</p>
          <p class="text-3xl wrap-break-word font-medium tracking-tight" data-text-reveal data-trigger="{{#unless isHomepage}}load{{/unless}}" data-delay="{{#unless isHomepage}}1{{/unless}}">thinhnguyen2572@gmail.com</p>
        </div>
      </div>
      <div class="bs-col-12 lg:bs-col-6 pt-10 lg:pt-0">
        <form action="" class="grid grid-cols-2 gap-6" data-reveal="group" data-trigger="{{#unless isHomepage}}load{{/unless}}" data-delay="{{#unless isHomepage}}1.2{{/unless}}">
          <div class="col-span-2">
            <label class="form-label" for="">Name</label>
            <input type="text" class="form-control" name="" id="" placeholder="Placeholder">
          </div>
          <div class="col-span-2 sm:col-span-1">
            <label class="form-label" for="">Name</label>
            <input type="text" class="form-control" name="" id="" placeholder="Placeholder">
          </div>
          <div class="col-span-2 sm:col-span-1">
            <label class="form-label" for="">Name</label>
            <input type="text" class="form-control" name="" id="" placeholder="Placeholder">
          </div>
          <div class="col-span-2">
            <label class="form-label" for="">I'm Interested in...</label>
            <div class="flex flex-wrap gap-3 pt-3">
              <input type="checkbox" id="tag-html" class="form-check-input">
              <label for="tag-html" class="form-check-label">HTML</label>
              <input type="checkbox" id="tag-css" class="form-check-input">
              <label for="tag-css" class="form-check-label">CSS</label>
              <input type="checkbox" id="tag-js" class="form-check-input">
              <label for="tag-js" class="form-check-label">JavaScript</label>
            </div>
          </div>
          <div class="col-span-2">
            <label class="form-label" for="">Name</label>
            <textarea class="form-control" rows="8" name="" id="" placeholder="Placeholder"></textarea>
          </div>
          <div class="col-span-2">
            <button type="button" class="btn btn-dark">
              <span class="hover-text">
                <span data-label="More About Me">More About Me</span>
              </span>
              <i class="icon-arrow-up-right text-sm"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>