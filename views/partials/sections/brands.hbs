<section id="brands" class="{{#if isLight}}bg-white{{else}}bg-black{{/if}}">
  <div class="container mx-auto">
    <div class="bs-row border
      {{#if isLight}}[border-image:linear-gradient(to_right,transparent,var(--color-gray-200),transparent)_1]{{else}}[border-image:linear-gradient(to_right,transparent,var(--color-gray-800),transparent)_1]{{/if}}">
      <div class="bs-col-12 sm:bs-col-2 pt-10 sm:pt-0 flex items-center justify-center sm:justify-start">
        <p class="body-lg text-gray-500">{{data.title}}</p>
      </div>
      <div class="bs-col-12 sm:bs-col-10">
        <div class="w-full overflow-hidden relative" data-marquee>
          <div class="absolute left-0 top-0 bottom-0 w-[15%] sm:w-[10%] lg:w-[5%] z-1 bg-linear-to-r {{#if isLight}}from-white{{else}}from-black{{/if}} to-transparent"></div>
          <div class="absolute right-0 top-0 bottom-0 w-[15%] sm:w-[10%] lg:w-[5%] z-1 bg-linear-to-l {{#if isLight}}from-white{{else}}from-black{{/if}} to-transparent"></div>
          <ul class="flex w-max" data-marquee-track>
            {{#each data.items}}
            <li class="brand-logo">
              <div class="brand-logo-img {{#if ../isLight}}bg-black{{else}}bg-white{{/if}}" style="mask-image: url('{{this}}'); -webkit-mask-image: url('{{this}}');"></div>
            </li>
            {{/each}}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>