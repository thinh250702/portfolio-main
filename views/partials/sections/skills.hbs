<section id="skills" class="{{#if isLight}}bg-white{{else}}bg-gray-900{{/if}} py-20">
  <div class="container mx-auto">
    <div class="bs-row mb-10">
      <div class="bs-col-12 md:bs-col-6 md:pt-3">
        <span class="eyebrow {{#if isLight}}text-black{{else}}text-white{{/if}}" data-reveal>{{data.eyebrow}}</span>
      </div>
      <div class="bs-col-12 md:bs-col-6">
        <h2 class="font-medium tracking-tighter mb-4 {{#if isLight}}text-black{{else}}text-white{{/if}}" data-text-reveal>{{data.heading}}</h2>
        <p class="body-lg {{#if isLight}}text-gray-600{{else}}text-gray-400{{/if}}" data-text-reveal data-split="lines">{{data.content}}</p>
      </div>
    </div>
    <div class="bs-row" data-accordion data-reveal="group">
      <div class="bs-col-12 md:bs-col-6 bs-order-last md:bs-order-first pr-0 md:pr-12">
        <div class="accordion-images">
          {{#each data.items}}
          <img src="{{this.imgUrl}}" alt="">
          {{/each}}
        </div>
      </div>
      <div class="bs-col-12 md:bs-col-6 bs-order-first md:bs-order-last">
        <ul class="accordion" data-reveal="group">
          {{#each data.items}}
          <li class="accordion-item {{#if ../isLight}}border-gray-200{{else}}border-gray-800{{/if}}">
            <div class="accordion-header {{#if ../isLight}}text-black{{else}}text-white{{/if}}"> 
              <span>{{number}}</span>
              <h3>{{title}}</h3>
            </div>
            <div class="accordion-collapse">
              <p class="{{#if ../isLight}}text-gray-600{{else}}text-gray-400{{/if}}">{{content}}</p>
              <div>
                {{#each badges}}
                <span class="badge {{#if ../../isLight}}badge-light{{else}}badge-dark{{/if}}">{{this}}</span>
                {{/each}}
              </div>
            </div>
          </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</section>