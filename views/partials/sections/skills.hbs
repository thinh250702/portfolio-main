<section id="skills" class="{{#if isLight}}is-light{{/if}} py-20 bg-gray-900 light:bg-white">
  <div class="container mx-auto">
    <div class="bs-row mb-10">
      <div class="bs-col-12 md:bs-col-6 md:pt-3">
        <span class="eyebrow text-white light:text-black" data-reveal>{{data.eyebrow}}</span>
      </div>
      <div class="bs-col-12 md:bs-col-6">
        <h2 class="font-medium tracking-tighter mb-4 text-white light:text-black" data-text-reveal>{{data.heading}}</h2>
        <p class="body-lg text-gray-400 light:text-gray-600" data-text-reveal data-split="lines">{{data.content}}</p>
      </div>
    </div>
    <div class="bs-row" data-accordion data-reveal="group">
      <div class="bs-col-12 md:bs-col-6 bs-order-last md:bs-order-first pr-0 md:pr-12">
        <div class="accordion-images">
          {{#each data.items}}
          <img src="{{this.imgUrl}}" alt="">
          {{/each}}
        </div>
      </div>
      <div class="bs-col-12 md:bs-col-6 bs-order-first md:bs-order-last">
        <ul class="accordion" data-reveal="group">
          {{#each data.items}}
          <li class="accordion-item border-gray-800 light:border-gray-200">
            <div class="accordion-header text-white light:text-black"> 
              <span>{{number}}</span>
              <h3>{{title}}</h3>
            </div>
            <div class="accordion-collapse">
              <p class="text-gray-400 light:text-gray-600">{{content}}</p>
              <div>
                {{#each badges}}
                <span class="badge badge-dark light:badge-light">{{this}}</span>
                {{/each}}
              </div>
            </div>
          </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</section>