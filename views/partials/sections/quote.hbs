<section id="quote" class="lg:pt-10">
  <div class="bg-[#cc0000]">
    <div class="container mx-auto">
      <div class="bs-row">
        <div class="bs-col-12 sm:bs-col-6 xl:bs-col-4 bs-order-last sm:bs-order-first aspect-526/393 relative">
          <img class="absolute bottom-0 w-full" src="https://res.cloudinary.com/dbmobxcxq/image/upload/v1784730395/portfolio-2026/xrzr7w8xw4bpqnqijutg_r9d0qv.webp" alt="" data-reveal>
        </div>
        <div class="bs-col-12 sm:bs-col bs-order-first sm:bs-order-last py-20 sm:py-10 flex flex-col justify-center">
          <i class="icon-quote text-[32px] text-white" data-reveal></i>
          <p class="body-md lg:body-lg my-4 text-white" data-text-reveal data-split="lines">{{data.quote}}</p>
          <div class="flex items-center gap-2.5 self-end" data-reveal>
            <img class="aspect-square w-7 object-cover rounded-full" src="{{data.avatar}}" alt="">
            <span class="body-md text-white">{{data.displayName}}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-black">
    <div class="container mx-auto">
      <div class="bs-row">
        <div class="bs-col-12 sm:bs-col-6 xl:bs-col-4 aspect-526/177 relative">
          <img class="absolute bottom-0 w-full" src="https://res.cloudinary.com/dbmobxcxq/image/upload/v1784730394/portfolio-2026/f31heng777giz8u905ye_q4aajg.webp" alt="">
        </div>
      </div>
    </div>
  </div>
</section>