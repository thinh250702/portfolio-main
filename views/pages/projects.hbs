<section id="hero" class="pt-(--header-height) pb-5 bg-linear-to-b from-gray-200 to-white">
  <div class="container mx-auto pt-10 md:pt-20">
    <div class="bs-row justify-between">
      <div class="bs-col-12 md:bs-col-6 flex flex-col items-center md:items-start justify-end">
        <h1 class="display-lg text-center md:text-left" data-text-reveal data-trigger="load">{{heading}}</h1>
      </div>
      <div class="bs-col-12 md:bs-col-6 xl:bs-col-4 flex flex-col justify-end">
        <p class="text-center md:text-left text-gray-600 mb-0 md:mb-2 xl:mb-4" data-text-reveal data-split="lines" data-trigger="load">{{content}}</p>
      </div>
    </div>
  </div>
</section>
<section id="projects" class="pt-5 pb-20">
  <div class="container mx-auto">
    <div class="bs-row">
      <ul class="card-grid" data-card-grid data-reveal="group" data-trigger="load" data-delay="0.2">
        <div class="cursor-label">View Project</div>
        {{#each projects}}
          {{> components/project-card this}}
        {{/each}}
      </ul>
    </div>
  </div>
</section>
