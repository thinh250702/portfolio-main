{{> sections/brands isLight=true}}
<section id="about" class="py-20 relative">
  <div class="w-full h-[20%] lg:h-[35%] xl:h-[40%] absolute bottom-0 bg-[url(/uploads/mountain-loop-black.png)] bg-cover bg-repeat-x bg-bottom"></div>
  <div class="w-full h-[20%] lg:h-[35%] xl:h-[40%] absolute bottom-0 bg-linear-to-t from-gray-900 to-transparent to-50%"></div>
  <div class="container mx-auto">
    <div class="bs-row mb-10">
      <div class="bs-col-12 md:bs-col-5">
        <span class="eyebrow" data-reveal>About Me</span>
      </div>
      <div class="bs-col">
        <h1 class="h2 font-medium tracking-tighter" data-text-reveal data-split="lines">In the game for over 6 years, I'm currently based in Ho Chi Minh city, working as an independent designer since July, 2022.</h1>
      </div>
    </div>
    <div class="bs-row mb-0 sm:mb-20 xl:mb-0">
      <div class="bs-col-12 sm:bs-col pt-0 xl:pt-[3%] mb-6 sm:mb-0">
        <h3 class="h4 font-medium tracking-tight" data-text-reveal>Experience & Innovation</h3>
        <p class="body-sm md:body-md lg:body-lg mt-2" data-text-reveal data-split="lines">I've spent 6+ years designing consumer-facing products, from high-stakes commerce flows to complex logistics dashboards. My process starts with research, moves through systems thinking, and ends in interfaces that earn trust under real-world pressure.</p>
      </div>
      <div class="bs-col-12 sm:bs-col-4 bs-order-3 sm:bs-order-2 mx-0 sm:mx-6 md:mx-8 lg:mx-12">
        {{> components/nft-card}}
      </div>
      <div class="bs-col-12 sm:bs-col bs-order-2 sm:bs-order-3  pt-0 md:pt-[6%] xl:pt-[12%] mb-6 sm:mb-0">
        <h3 class="h4 font-medium tracking-tight" data-text-reveal>Creative Expertise</h3>
        <p class="body-sm md:body-md lg:body-lg mt-2" data-text-reveal data-split="lines">With over a decade of design expertise, we create tailored solutions that engage audiences, build meaningful connections, and elevate brands with creativity and intent.</p>
        <a href="#" class="btn btn-dark mt-4" data-reveal>
          <span class="hover-text">
            <span data-label="View Resume">View Resume</span>
          </span>
          <i class="icon-arrow-up-right text-xs"></i>
        </a>
      </div>
    </div>
  </div>
</section>
