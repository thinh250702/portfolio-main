<section id="hero" class="h-screen overflow-hidden bg-linear-to-b from-gray-200 to-white flex justify-center items-center pt-(--header-height)">
  <div class="container">
    <div class="bs-row px-0 justify-center">
      <div class="bs-col-auto px-4">
        <p class="display-lg text-center font-weight-hover" data-text-reveal data-trigger="event" data-event="polaroid:revealComplete">{{hero.topHeading}}</p>
      </div>
      <div class="bs-col-12 flex justify-center">
        <ul id="polaroid-hero" data-polaroid-hero>
          {{#each hero.polaroids}}
          <li class="polaroid-item">
            <img class="polaroid-img" src="{{img}}" alt="">
            <img src="/uploads/polaroids/frame.png" alt="">
            <img src="{{doodle}}" alt="">
          </li>
          {{/each}}
        </ul>
      </div>
      <div class="bs-col-auto px-4">
        <p class="display-lg text-center font-weight-hover" data-text-reveal data-trigger="event" data-event="polaroid:revealComplete">{{hero.bottomHeading}}</p>
      </div>
    </div>
  </div>
</section>
{{> sections/brands data=brands isLight=true}}
<section id="about" class="py-20 relative" data-nft-card-canvas>
  <div class="w-full h-[20%] lg:h-[35%] xl:h-[40%] absolute bottom-0 bg-[url(https://res.cloudinary.com/dbmobxcxq/image/upload/v1784730393/portfolio-2026/nww28lqrmvrqwmlcnfyu_mb37px.webp)] bg-cover md:bg-contain bg-repeat-x bg-bottom"></div>
  <div class="w-full h-[20%] lg:h-[35%] xl:h-[40%] absolute bottom-0 bg-linear-to-t from-gray-900 to-transparent to-50%"></div>
  <div class="container mx-auto">
    <div class="bs-row mb-10">
      <div class="bs-col-12 md:bs-col-5">
        <span class="eyebrow" data-reveal>{{about.eyebrow}}</span>
      </div>
      <div class="bs-col">
        <h1 class="h2 font-medium tracking-tighter" data-text-reveal data-split="lines">{{about.heading}}</h1>
      </div>
    </div>
    <div class="bs-row mb-0 sm:mb-20 xl:mb-0">
      <div class="bs-col-12 sm:bs-col pt-0 xl:pt-[3%] mb-6 sm:mb-0">
        <h3 class="h4 font-medium tracking-tight" data-text-reveal>{{about.left.heading}}</h3>
        <p class="body-sm md:body-md lg:body-lg mt-2" data-text-reveal data-split="lines">{{about.left.content}}</p>
      </div>
      <div class="bs-col-12 sm:bs-col-4 bs-order-3 sm:bs-order-2 mx-0 sm:mx-6 md:mx-8 lg:mx-12">
        {{> components/nft-card}}
      </div>
      <div class="bs-col-12 sm:bs-col bs-order-2 sm:bs-order-3  pt-0 md:pt-[6%] xl:pt-[12%] mb-6 sm:mb-0">
        <h3 class="h4 font-medium tracking-tight" data-text-reveal>{{about.right.heading}}</h3>
        <p class="body-sm md:body-md lg:body-lg mt-2" data-text-reveal data-split="lines">{{about.right.content}}</p>
        <div class="mt-6 flex flex-col" data-reveal="group">
          <div>
            <a href="{{settings.resume.url}}" class="btn btn-dark">
              <span data-text-roll>{{settings.resume.label}}</span>
              <i class="icon-arrow-up-right text-sm"></i>
            </a>
          </div>
          <div class="flex items-center mt-3">
            <span class="relative flex size-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex size-2.5 rounded-full bg-green-500"></span>
            </span>
            <p class="uppercase ml-2.5">{{about.available}}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section id="journey" class="py-20 bg-gray-900 -mt-px">
  <div class="container mx-auto">
    <div class="bs-row pb-10 text-white">
      <div class="bs-col-12 md:bs-col">
        <span class="eyebrow" data-reveal>{{journey.eyebrow}}</span>
        <h2 class="font-medium tracking-tighter mb-4 md:mb-0" data-text-reveal>{{journey.heading}}</h2>
      </div>
      <div class="bs-col-12 md:bs-col flex items-end">
        <p class="body-lg text-gray-400" data-text-reveal data-split="lines">{{journey.content}}</p>
      </div>
    </div>
    <div class="bs-row pb-10">
      <span class="font-medium text-gray-500 uppercase" data-text-reveal data-split="lines">{{journey.education.heading}}</span>
      <ul class="journey-list mt-4" data-reveal="group">
        {{#each journey.education.items}}
        <li class="journey-list__item">
          <div class="journey-list__title">
            <h3 class="title-lg font-medium">{{title}}</h3>
            <span>{{subtitle}}</span>
          </div>
          <ul class="journey-list__body">
            {{#each content}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
          <div class="journey-list__date">
            <div>
              <span class="badge badge-dark">{{year}}</span>
            </div>
          </div>
        </li>
        {{/each}}
      </ul>
    </div>
    <div class="bs-row">
      <span class="font-medium text-gray-500 uppercase" data-text-reveal data-split="lines">{{journey.experience.heading}}</span>
      <ul class="journey-list mt-4" data-reveal="group">
        {{#each journey.experience.items}}
        <li class="journey-list__item">
          <div class="journey-list__title">
            <h3 class="title-lg font-medium">{{title}}</h3>
            <span>{{subtitle}}</span>
          </div>
          <ul class="journey-list__body">
            {{#each content}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
          <div class="journey-list__date">
            <div>
              <span class="badge badge-dark">{{year}}</span>
            </div>
          </div>
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
{{> sections/skills data=skills isLight=true}}
<section id="tools" class="pb-10">
  <div class="container mx-auto">
    <div class="bs-row justify-center">
      <div class="bs-col-12 md:bs-col-6 flex flex-col items-center">
        <span class="eyebrow" data-reveal>{{tools.eyebrow}}</span>
        <h2 class="mb-4 text-center font-medium tracking-tighter" data-text-reveal>{{tools.heading}}</h2>
        <p class="text-center body-lg text-gray-600" data-text-reveal data-split="lines">{{tools.content}}</p>
      </div>
      <div class="bs-col-12">
        <div class="w-full overflow-hidden relative py-10" data-marquee>
          <div class="absolute left-0 top-0 bottom-0 w-[15%] sm:w-[10%] lg:w-[5%] z-1 bg-linear-to-r from-white to-transparent"></div>
          <div class="absolute right-0 top-0 bottom-0 w-[15%] sm:w-[10%] lg:w-[5%] z-1 bg-linear-to-l from-white to-transparent"></div>
          <ul class="marquee-track flex w-max animate-marquee" data-marquee-track>
            {{#each tools.items}}
            <li class="tool-logo">
              <img src="{{imgUrl}}" alt="">
              <span class="font-medium">{{name}}</span>
            </li>
            {{/each}}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
{{> sections/quote data=quote}}