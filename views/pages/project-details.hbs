<section class="pt-(--header-height) pb-10" data-style="{{style hero.style}}">
  <div class="container mx-auto pt-10 md:pt-20">
    <div class="bs-row justify-between">
      <div class="bs-col-12 lg:bs-col-6">
        <div class="flex gap-2 mb-2">
          {{#each hero.category}}
            <a href="{{url}}" class="badge bg-white border-gray-200">{{name}}</a>
          {{/each}}
        </div>
        <h1 class="font-medium tracking-tighter mb-2" data-style="{{style hero.name.style}}">{{hero.name.text}}</h1>
        <p class="mb-6">{{hero.description}}</p>
        <a href="{{hero.button.href}}" class="btn btn-dark" data-style="{{style hero.button.style}}">
          <span class="hover-text">
            <span data-label="{{hero.button.label}}">{{hero.button.label}}</span>
          </span>
          <i class="icon-arrow-up-right text-xs"></i>
        </a>
      </div>
      <div class="bs-col-12 lg:bs-col-5 xl:bs-col-4 mt-10 lg:mt-0 flex flex-col justify-end">
        <ul class="metadata-list ">
          {{#each hero.metadata}}
            <li class="metadata-item">
              <span class="metadata-title">{{key}}</span>
              <span class="metadata-content">{{value}}</span>
            </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</section>
<section >
  <div class="carousel-wrapper overflow-hidden relative" data-carousel>
    <ul class="carousel-track flex items-center" data-carousel-track>
      {{#each carousel}}
        <li class="carousel-item" data-carousel-item>
          <img src="{{this}}" alt="" crossorigin="anonymous">
        </li>
      {{/each}}
    </ul>
  </div>
</section>
<section class="py-10" data-toc-title="{{overview.heading.text}}">
  <div class="container mx-auto">
    <div class="bs-row mb-10">
      <div class="bs-col-12 lg:bs-col">
        <h2 class="font-medium tracking-tight text-left mb-3 lg:mb-0" data-style="{{style overview.heading.style}}">{{overview.heading.text}}</h2>
      </div>
      <div class="bs-col-12 lg:bs-col">
        <div class="-mb-3 *:mb-3">
          {{#each overview.content}}
            {{renderBlock this}}
          {{/each}}
        </div>
      </div>
    </div>
    {{#if overview.logoGen}}
    <div class="bs-row mb-10 justify-center">
      <div class="bs-col-12">
        <div class="chat-wrapper bg-gray-100 border border-gray-200 overflow-hidden rounded-3xl" data-chat>
          <div class="flex justify-between p-4 lg:p-6 bg-white">
            <div>
              <p class="title-md lg:title-lg font-medium">BrandGen AI</p>
              <p class="body-sm lg:body-md text-gray-400">Press Send Button for animation</p>
            </div>
            <button type="button" class="chat-reset-btn chat-btn chat-btn-outlined">
              <i class="icon-refresh"></i>
            </button>
          </div>
          <div class="p-4 lg:p-6">
            <div class="flex justify-end mb-4 lg:mb-6">
              <div class="chat-bubble bg-gray-200 w-10/12 lg:w-1/2 px-4 lg:px-5 py-3 lg:py-4 rounded-2xl lg:rounded-[20px]">{{overview.logoGen.prompt}}</div>
            </div>
            <div>
              <div class="chat-shimmer-text flex items-center pb-2 lg:pb-3 gap-2">
                <dotlottie-wc 
                  src="/uploads/sparkle.lottie" 
                  autoplay 
                  loop 
                  style="width: 24px; height: 24px;">
                </dotlottie-wc>
                <p class="chat-skeleton-text">Creating your image...</p>
              </div>
              <div class="aspect-4/3 w-10/12 lg:w-4/12 relative">
                <img src="{{overview.logoGen.imgUrl}}" alt="" class="chat-result-img absolute w-full h-full object-cover rounded-2xl lg:rounded-[20px]">
                <div class="chat-skeleton-image absolute w-full h-full rounded-2xl lg:rounded-[20px] origin-top-left"></div>
              </div>
              <div class="chat-result-btn mt-2 lg:mt-3">
                <button type="button" class="chat-btn chat-btn-ghost">
                  <i class="icon-like"></i>
                </button>
                <button type="button" class="chat-btn chat-btn-ghost">
                  <i class="icon-dislike"></i>
                </button>
                <button type="button" class="chat-btn chat-btn-ghost">
                  <i class="icon-copy"></i>
                </button>
                <button type="button" class="chat-btn chat-btn-ghost">
                  <i class="icon-more"></i>
                </button>
              </div>
            </div>
          </div>
          <div class="px-4 lg:px-6">
            <div class="bg-white rounded-3xl lg:rounded-4xl shadow-md">
              <div class="px-5 lg:px-6 py-4 lg:py-5">
                <textarea name="" id="" rows="3" readonly class="chat-input w-full resize-none focus:outline-none" placeholder="Mô tả hình ảnh của bạn">{{overview.logoGen.prompt}}</textarea>
              </div>
              <div class="flex items-center justify-between px-3 pb-3 lg:px-4 lg:pb-4">
                <div class="flex items-center gap-2">
                  <button type="button" class="chat-btn chat-btn-ghost">
                    <i class="icon-plus"></i>
                  </button>
                  <span class="inline-flex items-center bg-gray-200 text-gray-500 py-1.5 pl-2 pr-2.5 gap-1 rounded-full">
                    <i class="icon-gallery text-[14px]"></i>
                    <span class="label-xs font-medium">Create image</span>
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <button type="button" class="chat-btn chat-btn-ghost">
                    <i class="icon-microphone text-[18px]"></i>
                  </button>
                  <button type="button" class="chat-send-btn chat-btn chat-btn-filled">
                    <i class="icon-arrow-up"></i>
                  </button>
                  <button type="button" class="chat-voice-btn chat-btn chat-btn-filled hidden">
                    <i class="icon-voice-line"></i>
                  </button>
                  <button type="button" class="chat-pause-btn chat-btn chat-btn-tonal hidden">
                    <div class="bg-black size-3.5 rounded-sm"></div>
                  </button>
                </div>
              </div>
            </div>
            <p class="body-xs lg:body-sm text-center my-3 lg:my-4 text-gray-400">{{overview.logoGen.warning}}</p>
          </div>
        </div>
      </div>
      <div class="bs-col lg:bs-col-8">
        <p class="text-center mt-5">{{overview.logoGen.description}}</p>
      </div>
    </div>
    {{/if}}
    <div class="bs-row justify-center">
      <div class="bs-col-12">
        <img src="{{overview.branding.imgUrl}}" alt="" class=" w-full object-cover">
      </div>
      <div class="bs-col lg:bs-col-8">
        <p class="text-center mt-5">{{overview.branding.description}}</p>
      </div>
    </div>
  </div>
</section>
