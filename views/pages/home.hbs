<section id="hero">
  <div class="bg-linear-to-b from-black to-[#cc0000] to-60% pt-(--header-height)">
    <div class="pt-10 sm:pt-20">
      <div class="container mx-auto relative">
        <div class="bs-row">
          <div class="bs-col-12">
            <p class="h4 sm:h3 mb-5 sm:mb-0 text-center font-medium tracking-tight text-white">©2026—Portfolio</p>
          </div>
          <div class="bs-col-12">
            <div class="horizontal-logo bg-white w-full hidden sm:block"></div>
            <div class="vertical-logo bg-white w-full sm:hidden"></div>
          </div>
        </div>
        <div class="bs-row justify-between absolute bottom-0 w-full">
          <div class="bs-col-5 flex justify-between">
            <span class="body-lg text-white hidden lg:inline-block">Junior UI/UX Designer</span>
            <span class="body-lg text-white hidden lg:inline-block">Based in Vietnam</span>
          </div>
          <div class="bs-col flex justify-end items-center text-white">
            <span class="mr-2 body-md sm:body-lg">Scroll Down</span>
            <i class="icon-arrow-down-right text-xs sm:text-sm"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-[url(/uploads/mountain-loop-red.png)] z-10 bg-cover bg-repeat-x bg-bottom">
      <div class="container mx-auto relative">
        <div class="bs-row justify-center">
          <div class="bs-col-12 sm:bs-col-7 lg:bs-col-5 aspect-526/393 relative">
            <img class="absolute bottom-0 w-full" src="/uploads/body-1.png" alt="">
          </div>
        </div>
        <div class="bs-row justify-between items-end absolute bottom-8 w-full text-white">
          <div class="bs-col-4">
            <h1 class="tracking-tight h2 md:h1 hidden sm:block">Creative studio for founder</h1>
          </div>
          <div class="bs-col-4">
            <p class="tracking-tight h4 md:h3 hidden sm:block">Hey there, I am Thinh, a UI/UX designer polishing ideas until they shine</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-black">
    <div class="container mx-auto relative">
      <div class="bs-row justify-center">
        <div class="bs-col-12 sm:bs-col-7 lg:bs-col-5 aspect-526/177 relative">
          <img class="absolute bottom-0 w-full" src="/uploads/chessboard.png" alt="">
        </div>
      </div>
      <div class="bs-row sm:absolute sm:top-1/2 sm:-translate-y-1/2 pb-10 sm:pb-0 w-full">
        <div class="bs-col">
          <p class="body-sm sm:body-sm text-white/60 mb-1">Time Zone</p>
          <p class="body-md sm:body-lg text-white">UTC +7, 11:30 PM</p>
        </div>
        <div class="bs-col">
          <p class="text-right body-sm sm:body-sm text-white/60 mb-1">Location</p>
          <p class="text-right body-md sm:body-lg text-white">Ho Chi Minh, VN</p>
        </div>
      </div>
    </div>
  </div>
</section>
{{> sections/brands}}
<section id="about" class="bg-black py-20">
  <div class="container mx-auto">
    <div class="bs-row">
      <div class="bs-col-12 sm:bs-col-6 lg:bs-col-5 xl:bs-col-4 bs-order-last sm:bs-order-first pt-10 sm:pt-0">
        {{> components/nft-card}}
      </div>
      <div class="bs-col-12 sm:bs-col flex flex-col justify-center pl-0 sm:pl-6 md:pl-12 bs-order-first sm:bs-order-last">
        {{> components/eyebrow 
          label="About Me" 
          color="text-white"
        }}
        <h2 class="font-medium tracking-tighter mb-4 text-white">Hey there, I am Thinh, a UI/UX designer polishing ideas until they shine</h2>
        <p class="mb-4 body-lg text-white">I've spent 6+ years designing consumer-facing products, from high-stakes commerce flows to complex logistics dashboards. My process starts with research, moves through systems thinking, and ends in interfaces that earn trust under real-world pressure.</p>
        <p class="mb-4 body-lg text-white">I don't just follow briefs, I reframe them. Good design, to me, begins before the first pixel and persists long after the last release.</p>
        <div class="mt-2">
          <a href="" class="btn btn-light">
            <span class="hover-text">
              <span data-label="More About Me">More About Me</span>
            </span>
            <i class="icon-arrow-up-right text-sm"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="bg-[#cc0000] py-10">
  <div class="w-full overflow-hidden" data-marquee data-marquee-clone="2">
    <ul class="flex w-max" data-marquee-track>
      <li class="flex items-center gap-8 text-white mr-8">
        <i class="icon-arrow-up-right text-2xl"></i>
        <span class="text-5xl font-medium tracking-tighter leading-tight">Graphic Design</span>
      </li>
      <li class="flex items-center gap-8 text-white mr-8">
        <i class="icon-arrow-up-right text-2xl"></i>
        <span class="text-5xl font-medium tracking-tighter leading-tight">UI/UX Design</span>
      </li>
      <li class="flex items-center gap-8 text-white mr-8">
        <i class="icon-arrow-up-right text-2xl"></i>
        <span class="text-5xl font-medium tracking-tighter leading-tight">Web Development Design</span>
      </li>
    </ul>
  </div>
</section>
<section id="projects" class="py-20">
  <div class="container mx-auto">
      <div class="bs-row mb-10">
        <div class="bs-col-12 lg:bs-col-2 pt-0 lg:pt-3">
          {{> components/eyebrow 
            label="Portfolio"
          }}
        </div>
        <div class="bs-col-12 lg:bs-col-4 mb-4 lg:mb-0">
          <h2 class="h1 font-medium tracking-tighter">Explore my featured works</h2>
        </div>
        <div class="bs-col-12 lg:bs-col-4 lg:bs-offset-2 flex items-end">
          <p class="body-lg">A curated selection of projects where strategy, creativity, and craftsmanship come together to build meaningful and enduring brand experiences.</p>
        </div>
      </div>
      <div class="bs-row mb-10">
        <ul class="card-grid" data-card-grid>
          <div class="cursor-label">View Project</div>
          {{> components/project-card}}
          {{> components/project-card}}
          {{> components/project-card}}
          {{> components/project-card}}
        </ul>
      </div>
      <div class="bs-row justify-center">
        <div class="bs-col-auto">
          <a href="" class="btn btn-dark">
            <span class="hover-text">
              <span data-label="More About Me">More About Me</span>
            </span>
            <i class="icon-arrow-up-right text-sm"></i>
          </a>
        </div>
      </div>
    </div>
</section>
