<section id="hero">
  <div class="bg-linear-to-b from-black to-[#cc0000] to-60% pt-(--header-height)">
    <div class="pt-10 sm:pt-20">
      <div class="container mx-auto relative">
        <div class="bs-row" data-reveal="group" data-trigger="load">
          <div class="bs-col-12">
            <p class="h4 sm:h3 mb-5 sm:mb-0 text-center font-medium tracking-tight text-white">©2026—Portfolio</p>
          </div>
          <div class="bs-col-12">
            <div class="horizontal-logo bg-white w-full hidden sm:block"></div>
            <div class="vertical-logo bg-white w-full sm:hidden"></div>
          </div>
        </div>
        <div class="bs-row justify-between absolute bottom-0 w-full">
          <div class="bs-col-5 flex justify-between">
            <span class="body-lg text-white hidden lg:inline-block" data-reveal data-trigger="load" data-delay="0.3">Junior UI/UX Designer</span>
            <span class="body-lg text-white hidden lg:inline-block" data-reveal data-trigger="load" data-delay="0.4">Based in Thịnh Nguyễn</span>
          </div>
          <div class="bs-col flex justify-end items-center text-white" data-reveal data-trigger="load" data-delay="0.5">
            <span class="mr-2 body-md sm:body-lg">Scroll Down</span>
            <i class="icon-arrow-down-right text-xs sm:text-sm"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-[url(https://res.cloudinary.com/dbmobxcxq/image/upload/v1784730201/portfolio-2026/mountain-loop-red_vtvrzn.webp)] z-10 bg-cover bg-repeat-x bg-bottom">
      <div class="container mx-auto relative">
        <div class="bs-row justify-center">
          <div class="bs-col-12 sm:bs-col-7 lg:bs-col-5 aspect-526/393 relative">
            <img class="absolute bottom-0 w-full" src="https://res.cloudinary.com/dbmobxcxq/image/upload/v1784730395/portfolio-2026/xrzr7w8xw4bpqnqijutg_r9d0qv.webp" alt="" data-reveal data-trigger="load" data-delay="0.3">
          </div>
        </div>
        <div class="bs-row justify-between items-end absolute bottom-8 w-full text-white">
          <div class="bs-col-4">
            <h1 class="tracking-tight h2 md:h1 hidden sm:block font-medium" data-text-reveal>Creative studio for founder</h1>
          </div>
          <div class="bs-col-4">
            <p class="tracking-tight h4 md:h3 hidden sm:block font-medium" data-text-reveal>Hey there, I am Thinh, a UI/UX designer polishing ideas until they shine</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-black">
    <div class="container mx-auto relative">
      <div class="bs-row justify-center">
        <div class="bs-col-12 sm:bs-col-7 lg:bs-col-5 aspect-526/177 relative">
          <img class="absolute bottom-0 w-full" src="https://res.cloudinary.com/dbmobxcxq/image/upload/v1784730394/portfolio-2026/f31heng777giz8u905ye_q4aajg.webp" alt="">
        </div>
      </div>
      <div class="bs-row sm:absolute sm:top-1/2 sm:-translate-y-1/2 pb-10 sm:pb-0 w-full">
        <div class="bs-col">
          <p class="body-sm sm:body-sm text-white/60 mb-1">Time Zone</p>
          <p class="body-md sm:body-lg text-white">UTC +7, 11:30 PM</p>
        </div>
        <div class="bs-col">
          <p class="text-right body-sm sm:body-sm text-white/60 mb-1">Location</p>
          <p class="text-right body-md sm:body-lg text-white">Ho Chi Minh, VN</p>
        </div>
      </div>
    </div>
  </div>
</section>
{{> sections/brands}}
<section id="about" class="bg-black py-20">
  <div class="container mx-auto">
    <div class="bs-row">
      <div class="bs-col-12 sm:bs-col-6 lg:bs-col-5 xl:bs-col-4 bs-order-last sm:bs-order-first pt-10 sm:pt-0">
        {{> components/nft-card}}
      </div>
      <div class="bs-col-12 sm:bs-col flex flex-col justify-center pl-0 sm:pl-6 md:pl-12 bs-order-first sm:bs-order-last">
        <span class="eyebrow text-white" data-reveal> About Me</span>
        <h2 class="font-medium tracking-tighter mb-4 text-white" data-text-reveal data-split="lines">Hey there, I am Thinh, a UI/UX designer polishing ideas until they shine</h2>
        <p class="mb-4 body-lg text-white" data-text-reveal data-split="lines">I've spent 6+ years designing consumer-facing products, from high-stakes commerce flows to complex logistics dashboards. My process starts with research, moves through systems thinking, and ends in interfaces that earn trust under real-world pressure.</p>
        <p class="mb-4 body-lg text-white" data-text-reveal data-split="lines">I don't just follow briefs, I reframe them. Good design, to me, begins before the first pixel and persists long after the last release.</p>
        <div class="mt-2 flex flex-col lg:flex-row items-left lg:items-center" data-reveal="group">
          <div>
            <a href="/about" class="btn btn-light">
              <span class="hover-text">
                <span data-label="More About Me">More About Me</span>
              </span>
              <i class="icon-arrow-up-right text-sm"></i>
            </a>
          </div>
          <div class="flex items-center mt-4 lg:ml-6 lg:mt-0">
            <span class="relative flex size-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex size-2.5 rounded-full bg-green-500"></span>
            </span>
            <p class="text-white uppercase ml-2.5">Availabel for hire</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
