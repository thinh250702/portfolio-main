<section id="hero">
  <div class="bg-linear-to-b from-black to-primary to-60% pt-(--header-height)">
    <div class="pt-10 sm:pt-20">
      <div class="container mx-auto relative">
        <div class="bs-row" data-reveal="group" data-trigger="load">
          <div class="bs-col-12">
            <p class="h4 sm:h3 mb-5 sm:mb-0 text-center font-medium tracking-tight text-white">{{hero.title}}</p>
          </div>
          <div class="bs-col-12">
            <div class="horizontal-logo bg-white w-full hidden sm:block"></div>
            <div class="vertical-logo bg-white w-full sm:hidden"></div>
          </div>
        </div>
        <div class="bs-row justify-between absolute bottom-0 w-full">
          <div class="bs-col-5 flex justify-between">
            <span class="body-lg text-white hidden lg:inline-block" data-reveal data-trigger="load" data-delay="0.3">{{hero.role}}</span>
            <span class="body-lg text-white hidden lg:inline-block" data-reveal data-trigger="load" data-delay="0.4">{{hero.location}}</span>
          </div>
          <div class="bs-col flex justify-end items-center text-white" data-reveal data-trigger="load" data-delay="0.5">
            <span class="mr-2 body-md sm:body-lg">Scroll Down</span>
            <i class="icon-arrow-down-right text-xs sm:text-sm"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-[url(/uploads/mountain-loop-red.webp)] z-10 bg-cover bg-repeat-x bg-bottom">
      <div class="container mx-auto relative">
        <div class="bs-row justify-center">
          <div class="bs-col-12 sm:bs-col-7 lg:bs-col-5 aspect-526/393 relative">
            <img class="absolute bottom-0 w-full" src="/uploads/body-1.webp" alt="" data-reveal data-trigger="load" data-delay="0.3">
          </div>
        </div>
        <div class="bs-row justify-between items-end absolute bottom-8 w-full text-white">
          <div class="bs-col-4">
            <h1 class="tracking-tight h2 md:h1 hidden sm:block font-medium" data-text-reveal data-trigger="load" data-delay="0.6">{{hero.heading}}</h1>
          </div>
          <div class="bs-col-4">
            <p class="tracking-tight h4 md:h3 hidden sm:block font-medium" data-text-reveal data-trigger="load" data-delay="0.7">{{hero.content}}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-black">
    <div class="container mx-auto relative">
      <div class="bs-row justify-center">
        <div class="bs-col-12 sm:bs-col-7 lg:bs-col-5 aspect-526/177 relative">
          <img class="absolute bottom-0 w-full" src="/uploads/chessboard.webp" alt="">
        </div>
      </div>
      <div class="bs-row sm:absolute sm:top-1/2 sm:-translate-y-1/2 pb-10 sm:pb-0 w-full">
        <div class="bs-col">
          <p class="body-sm sm:body-sm text-white/60 mb-1">{{hero.metadata.timezone.key}}</p>
          <p class="body-md sm:body-lg text-white" data-current-time></p>
        </div>
        <div class="bs-col">
          <p class="text-right body-sm sm:body-sm text-white/60 mb-1">{{hero.metadata.location.key}}</p>
          <p class="text-right body-md sm:body-lg text-white">{{hero.metadata.location.value}}</p>
        </div>
      </div>
    </div>
  </div>
</section>
{{> sections/brands data=brands}}
<section id="about" class="bg-black py-20" data-nft-card-canvas>
  <div class="container mx-auto">
    <div class="bs-row">
      <div class="bs-col-12 sm:bs-col-6 lg:bs-col-5 xl:bs-col-4 bs-order-last sm:bs-order-first pt-10 sm:pt-0">
        {{> components/nft-card}}
      </div>
      <div class="bs-col-12 sm:bs-col flex flex-col justify-center pl-0 sm:pl-6 md:pl-12 bs-order-first sm:bs-order-last">
        <span class="eyebrow text-white" data-reveal>{{about.eyebrow}}</span>
        <h2 class="font-medium tracking-tighter mb-4 text-white" data-text-reveal data-split="lines">{{about.heading}}</h2>
        {{#each about.content}}
          <p class="mb-4 text-white" data-text-reveal data-split="lines">{{this}}</p>
        {{/each}}
        <div class="mt-2 flex flex-col lg:flex-row items-left lg:items-center" data-reveal="group">
          <div>
            <a href="{{about.button.href}}" class="btn btn-light">
              <span data-text-roll>{{about.button.label}}</span>
              <i class="icon-arrow-up-right text-sm"></i>
            </a>
          </div>
          <div class="flex items-center mt-4 lg:ml-6 lg:mt-0">
            <span class="relative flex size-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex size-2.5 rounded-full bg-green-500"></span>
            </span>
            <p class="text-white uppercase ml-2.5">{{about.available}}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="bg-primary py-10">
  <div class="w-full overflow-hidden" data-marquee data-marquee-clone="2">
    <ul class="flex w-max" data-marquee-track>
      <li class="flex items-center gap-8 text-white mr-8">
        <i class="icon-arrow-up-right text-2xl"></i>
        <span class="text-5xl font-medium tracking-tighter leading-tight">Graphic Design</span>
      </li>
      <li class="flex items-center gap-8 text-white mr-8">
        <i class="icon-arrow-up-right text-2xl"></i>
        <span class="text-5xl font-medium tracking-tighter leading-tight">UI/UX Design</span>
      </li>
      <li class="flex items-center gap-8 text-white mr-8">
        <i class="icon-arrow-up-right text-2xl"></i>
        <span class="text-5xl font-medium tracking-tighter leading-tight">Web Development</span>
      </li>
    </ul>
  </div>
</section>
<section id="projects" class="py-20">
  <div class="container mx-auto">
      <div class="bs-row mb-10">
        <div class="bs-col-12 lg:bs-col-2 pt-0 lg:pt-3">
          <span class="eyebrow text-black" data-reveal>{{works.eyebrow}}</span>
        </div>
        <div class="bs-col-12 lg:bs-col-4 mb-4 lg:mb-0">
          <h2 class="h1 font-medium tracking-tighter" data-text-reveal>{{works.heading}}</h2>
        </div>
        <div class="bs-col-12 lg:bs-col-4 lg:bs-offset-2 flex items-end">
          <p class="body-lg text-gray-600" data-text-reveal data-split="lines">{{works.content}}</p>
        </div>
      </div>
      <div class="bs-row mb-10">
        <ul class="card-grid" data-card-grid data-reveal="group">
          {{#each projects}}
            {{> components/project-card this}}
          {{/each}}
        </ul>
      </div>
      <div class="bs-row justify-center">
        <div class="bs-col-auto">
          <a href="{{works.button.href}}" class="btn btn-dark">
            <span data-text-roll>{{works.button.label}}</span>
            <i class="icon-arrow-up-right text-sm"></i>
          </a>
        </div>
      </div>
    </div>
</section>
{{> sections/skills data=skills}}
{{> sections/contact isHomepage=true data=contactForm}}
<section class="pb-20">
  <div class="w-full overflow-hidden" data-marquee>
    <ul class="flex w-max will-change-transform" data-marquee-track>
      <li class="flex items-center gap-16 text-gray-200 mr-16">
        <i class="icon-arrow-up-right text-6xl"></i>
        <span class="text-9xl font-medium tracking-tighter leading-tight">Graphic Design</span>
      </li>
      <li class="flex items-center gap-16 text-gray-200 mr-16">
        <i class="icon-arrow-up-right text-6xl"></i>
        <span class="text-9xl font-medium tracking-tighter leading-tight">UI/UX Design</span>
      </li>
      <li class="flex items-center gap-16 text-gray-200 mr-16">
        <i class="icon-arrow-up-right text-6xl"></i>
        <span class="text-9xl font-medium tracking-tighter leading-tight">Web Development</span>
      </li>
    </ul>
  </div>
</section>

