<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  {{{vite "main.js"}}}
  <script type="module" src="https://unpkg.com/@lottiefiles/dotlottie-wc@latest/dist/dotlottie-wc.js"></script>
  <!-- Open Graph / Facebook / Zalo / LinkedIn -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Thịnh Nguyễn | ©2026—Portfolio">
  <meta property="og:description" content="Explore the portfolio of Thinh Nguyen, a UI/UX Designer creating clean, intuitive, and user-centered digital experiences for websites and mobile applications.">
  <meta property="og:image" content="/uploads/thumbnail.png">
  <meta property="og:image:secure_url" content="/uploads/thumbnail.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="Thinh Nguyen UI/UX Portfolio Website Thumbnail">
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Thịnh Nguyễn | ©2026—Portfolio">
  <meta name="twitter:description" content="Explore the portfolio of Thinh Nguyen, a UI/UX Designer creating clean, intuitive, and user-centered digital experiences for websites and mobile applications.">
  <meta name="twitter:image" content="/uploads/thumbnail.png">
  <meta name="twitter:image:alt" content="Thinh Nguyen UI/UX Portfolio Website Thumbnail">
  <!-- Favicons -->
  <link rel="icon" href="/favicon/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
  <link rel="manifest" href="/favicon/site.webmanifest">
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-WL2V328F');</script>
  <!-- End Google Tag Manager -->
</head>
<body>
  <div class="page-transition" data-page-transition>
    <div class="pt-wrapper">
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
      <div class="pt-column"></div>
    </div>
    <div class="pt-logo symbol-logo"></div>
  </div>
  {{#if showToc}}
  <div class="toc pointer-events-none" data-toc>
    <div class="toc-bg"></div>
    <ul class="toc-list">
    </ul>
    <button class="toc-toggle btn btn-icon text-gray-500 pointer-events-auto">
      <i class="icon-menu text-lg"></i>
    </button>
  </div>
  {{/if}}
  <div class="cursor-label">View Project</div>
  {{> global/header isLight=isHeaderLight isAbout=isAbout}}
  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>
        {{{body}}}
      </main>
      {{> global/footer}}
    </div>
  </div>
</body>
</html>