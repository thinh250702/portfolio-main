{
  "name": "portfolio-main",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "dev:css": "tailwindcss -i ./src/css/main.css -o ./public/css/main.css --watch",
    "build:css": "tailwindcss -i ./src/css/main.css -o ./public/css/main.css --minify"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "^4.22.2",
    "express-handlebars": "^9.0.1",
    "http-errors": "~1.6.3",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3"
  }
}
